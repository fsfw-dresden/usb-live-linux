#!/bin/bash +x
# Briefly flash active tmux pane background color to give 

# Usage:
# tmux-pane-flash [ -w {tmux_window_id} ] [ STEP DURATION in seconds ] [ PRESET NAME | SEQUENCE OF HEX COLORS ]

# Get current window id
WINDOW_ID=$(tmux display-message -p '#{window_id}')
[ "${1}" = "-w" ] && {
  # If window given as parameter does not exist, abort
  [ -n "$(tmux list-windows -f "#{==:#{window_id},${2}}")" ] || exit

  WINDOW_ID=${2}
  shift 2
}

# Prevent flashes from queuing up with ephemeral per-user/per-window lock 
LOCK_FILE=/run/lock/tmux-flash.$(id -u).${WINDOW_ID}
exec 4<>${LOCK_FILE} && flock --nonblock 4 || exit 0

# Default to 0.05s = 50ms
STEP_DURATION=${1:-0.05}
shift

declare -A PRESETS
PRESETS=(
  [GREEN]="003f00 002f00 000f00"
  [RED]="3f0000 2f0000 0f0000"
  [GRAY]="9f9f9f 8f8f8f 3f3f3f 2f2f2f 1f1f1f 0f0f0f"
  [PHUNKY]="ff0000 ffff00 0fff00"
)

# Set colors according to number of arguments given
case ${#} in
 0) [ "$(id -u)" -eq 0 ] \
      && COLORS="${PRESETS[RED]}" \
      || COLORS="${PRESETS[GREEN]}"
    ;;
 1) COLORS="${PRESETS[${1}]}"
    ;;
 *) COLORS="${*}"
    ;;
esac

{
  # Unset the bg style on exit and remove lock file
  # shellcheck disable=SC2064
  trap "tmux set -u -t ${WINDOW_ID} window-active-style; rm ${LOCK_FILE}" 0 1 2 3 15

  for COLOR in ${COLORS}
  do
    tmux set -t $WINDOW_ID window-active-style bg="#${COLOR}"
    sleep ${STEP_DURATION}
  done 
} &
