#!/bin/bash
{
  read -sn1 -p "[r] to respawn, [any] other key to exit"
  case $REPLY in
    r)
      # push text on screen into pane history, then re-exec
      eval printf -- '\\n%.s' {0..$(tput lines)}
      tmux respawn-pane -k;;
    *) echo
  esac

  # allow passing exit status as parameter, $? wouldn't work
  exit $1
}
