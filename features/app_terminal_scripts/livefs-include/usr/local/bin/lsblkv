#!/bin/sh
#export LIBSMARTCOLS_DEBUG_PADDING=on

PATHS="--paths"
COLUMNS=$(tput cols)
if [ ${COLUMNS} -ge 200 ]
then
  OUTPUT="ID-LINK,FSTYPE,SIZE,NAME,MOUNTPOINT,LABEL,FSUSE%,FSAVAIL,RM,RO,STATE"
elif [ ${COLUMNS} -ge 108 ]
then
  OUTPUT="VENDOR,MODEL,FSTYPE,SIZE,NAME,KNAME,LABEL,FSUSE%,FSAVAIL,RM,RO,STATE"
elif [ ${COLUMNS} -ge 78 ]
then
  OUTPUT="MODEL,SIZE,FSTYPE,NAME,MOUNTPOINT,LABEL,FSUSE%,FSAVAIL"
  PATHS=""
else
  OUTPUT="MODEL,SIZE,FSTYPE,NAME,FSUSE%,FSAVAIL"
  PATHS=""
fi
lsblk ${PATHS} -m --merge --width ${COLUMNS} --output ${OUTPUT} "${@}"
