#!/bin/sh +x
# Convenience wrapper to search for a command's PID

[ $# -gt 0 ] && CMD="${1}" || read -p 'Please enter command name to find PID of: ' CMD
[ -n "${2}" ] && _USER="-u ${2}"

# Only invoke fzf if stdin is interactive, otherwise pick oldest process
tty > /dev/null \
  && PID=$(pgrep -la ${_USER} "${CMD}" | fzf --exact --height=~100% --border --reverse --header "pgrep -la '${CMD}'" | awk '{print $1}') \
  || PID=$(pgrep --oldest "${CMD}")

[ -z "$PID" ] && echo "No process found or selected, aborting." >&2 || echo $PID
